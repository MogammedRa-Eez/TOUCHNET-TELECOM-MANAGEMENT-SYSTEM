{
  "name": "Sync Coverage Zone on Project Live/Billed",
  "description": "Geocodes the site_address of a FibreProject when its status becomes live or billed, storing lat/lng for the coverage map.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"live\" or .trigger.data.status == \"billed\") and (.trigger.data.site_address != null and .trigger.data.site_address != \"\" and .trigger.data.site_address != [] and .trigger.data.site_address != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "FibreProject"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_coverage_zone_on_project_live_billed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCoverageZone",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncCoverageZone"
  }
}