{
  "name": "Fibre Status Email Notifier",
  "description": "Sends a branded HTML email to the customer whenever their fibre project status changes",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FibreProject"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fibre_status_email_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fibreStatusEmailNotifier",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "fibreStatusEmailNotifier"
  }
}