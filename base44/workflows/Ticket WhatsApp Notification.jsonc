{
  "name": "Ticket WhatsApp Notification",
  "description": "Sends a WhatsApp message to the customer when their ticket status changes or a technician adds/updates resolution notes.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.changed_fields | index(\"resolution_notes\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Ticket"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ticket_whatsapp_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ticketWhatsAppNotify",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "ticketWhatsAppNotify"
  }
}